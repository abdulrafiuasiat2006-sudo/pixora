{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile and authentication status",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "emailVerified": { "type": "boolean" }
      },
      "required": ["id", "email"]
    },
    "UserProject": {
      "title": "UserProject",
      "description": "Persistent project workspace and settings",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "tool": { "type": "string" },
        "configSummary": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "tool"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile document"
    },
    "/users/{userId}/projects/{projectId}": {
      "schema": "UserProject",
      "description": "User personal saved projects"
    }
  }
}
